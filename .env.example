# ============================================================
# Amia Vet — environment variables
# Copy to .env for local dev:  cp .env.example .env
# In Railway, set each of these under the service's "Variables" tab.
# ============================================================

# ---- Database (Railway Postgres plugin) ----
# Locally: a Postgres connection string.
# On Railway: reference the Postgres plugin var, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amiavet?schema=public"

# ---- Auth.js (NextAuth v5) ----
# Generate a secret:  openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Canonical URL of the app. Local: http://localhost:3000 ; Railway: your service URL.
AUTH_URL="http://localhost:3000"
# Trust the host header (required on Railway behind its proxy).
AUTH_TRUST_HOST="true"

# ---- Google OAuth (Auth.js provider) ----
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Resend (magic-link email + notifications) ----
# API key from https://resend.com/api-keys
AUTH_RESEND_KEY=""
# Verified sender address (must be on a domain verified in Resend).
EMAIL_FROM="Amia Vet <hello@amiavet.com>"

# ---- Anthropic (server-side LLM only; never exposed to the client) ----
ANTHROPIC_API_KEY=""
# Model id. See https://docs.anthropic.com for current model names.
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ---- Stripe (used from phase 4 onward) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs for the two products (create in the Stripe dashboard).
STRIPE_PRICE_VET_REVIEW=""   # $20 vet review
STRIPE_PRICE_VIDEO_VISIT=""  # $40 video visit

# ---- Video visit (external scheduling tool) ----
# The booking link owners receive after paying for a video visit.
VIDEO_BOOKING_URL="https://cal.com/amiavet/15min"

# ---- Photo uploads (DEFERRED in v1 — Cloudflare R2 / S3-compatible) ----
# Left blank; upload is stubbed. Fill these in when photo upload is enabled.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
