// ============================================================
// Amia Vet — Prisma schema
// Postgres (Railway Postgres plugin). Full v1 data model.
// The vet/payment/video tables exist now so migrations are complete;
// their UIs are built in later phases.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  owner
  vet
  admin
}

enum ConsultStatus {
  ai_answered
  review_requested
  reviewed
  video_booked
  closed
}

enum Urgency {
  info
  monitor
  see_vet
  urgent
}

enum MessageRole {
  owner
  ai
  vet
  system
}

enum ReviewStatus {
  pending
  in_progress
  completed
}

enum Verdict {
  fine_at_home
  monitor
  see_vet
  urgent
}

enum PaymentType {
  vet_review
  video_visit
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum VideoStatus {
  pending
  booked
  completed
  canceled
}

// ---------------- Auth.js standard tables ----------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(owner)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  pets     Pet[]
  consults Consult[]
  payments Payment[]
  vet      Vet?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------- Domain tables ----------------

model Pet {
  id             String   @id @default(cuid())
  userId         String
  name           String
  species        String // dog, cat, etc.
  breed          String?
  sex            String?
  birthdateOrAge String? // free text: "3 years" or a date the owner typed
  weightLbs      Float?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary  PetSummary?
  consults Consult[]

  @@index([userId])
}

// Compact, regenerated summary of a pet's history so we inject small context.
model PetSummary {
  id             String   @id @default(cuid())
  petId          String   @unique
  runningSummary String   @default("") @db.Text
  updatedAt      DateTime @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Consult {
  id        String        @id @default(cuid())
  petId     String
  userId    String
  status    ConsultStatus @default(ai_answered)
  urgency   Urgency       @default(info)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  pet      Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConsultMessage[]
  review   VetReview?
  payments Payment[]
  video    VideoBooking?
  aiLogs   AiLog[]

  @@index([userId])
  @@index([petId])
  @@index([status])
}

model ConsultMessage {
  id        String      @id @default(cuid())
  consultId String
  role      MessageRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  consult Consult @relation(fields: [consultId], references: [id], onDelete: Cascade)

  @@index([consultId])
}

model VetReview {
  id             String       @id @default(cuid())
  consultId      String       @unique
  vetId          String
  status         ReviewStatus @default(pending)
  verdict        Verdict?
  feedbackToOwner String?     @db.Text
  aiProbeLog     Json? // transcript of vet's probing questions to the AI
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  consult Consult @relation(fields: [consultId], references: [id], onDelete: Cascade)
  vet     Vet     @relation(fields: [vetId], references: [id])

  @@index([vetId])
  @@index([status])
}

model Vet {
  id              String   @id @default(cuid())
  userId          String   @unique
  caLicenseNumber String
  plitOnFile      Boolean  @default(false) // professional liability insurance on file
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews VetReview[]
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  consultId       String
  type            PaymentType
  stripeSessionId String?       @unique
  amountCents     Int
  status          PaymentStatus @default(pending)
  createdAt       DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  consult Consult @relation(fields: [consultId], references: [id], onDelete: Cascade)

  @@index([consultId])
  @@index([userId])
}

model VideoBooking {
  id          String      @id @default(cuid())
  consultId   String      @unique
  externalUrl String?
  scheduledAt DateTime?
  vetId       String?
  status      VideoStatus @default(pending)
  createdAt   DateTime    @default(now())

  consult Consult @relation(fields: [consultId], references: [id], onDelete: Cascade)
}

// Full audit trail of every model prompt/response.
model AiLog {
  id        String   @id @default(cuid())
  consultId String?
  prompt    String   @db.Text
  response  String   @db.Text
  model     String
  createdAt DateTime @default(now())

  consult Consult? @relation(fields: [consultId], references: [id], onDelete: SetNull)

  @@index([consultId])
}
